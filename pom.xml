<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         Spring Boot Parent BOM
         Using the parent POM gives us:
           - Managed dependency versions (no version conflicts)
           - Pre-configured Maven plugins (compiler, surefire, etc.)
           - Sensible defaults for packaging
         ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!-- ============================================================
         Project Coordinates
         groupId   : reverse-domain convention (your organization)
         artifactId: the jar name
         version   : SNAPSHOT = work in progress, not a release
         ============================================================ -->
    <groupId>com.notificationplatform</groupId>
    <artifactId>notification-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Notification Platform</name>
    <description>Distributed Notification Platform — Phase 0: Project Bootstrap</description>

    <!-- ============================================================
         Properties
         java.version is read by the spring-boot-starter-parent
         to configure the Maven compiler plugin automatically.
         ============================================================ -->
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- ============================================================
         Dependencies — Phase 0 only
         We deliberately include ONLY what is needed right now.
         Adding unused dependencies violates YAGNI (You Aren't
         Gonna Need It) and increases build time, attack surface,
         and cognitive load.
         ============================================================ -->
    <dependencies>

        <!-- Spring MVC + Embedded Tomcat
             Gives us: @RestController, @GetMapping, embedded server.
             We don't need a separate web server installation. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Actuator
             Gives us: /actuator/health, /actuator/info out of the box.
             Production-grade operations support from day one.
             Metrics integration (Micrometer) comes with this. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation with Hibernate Validator
             Gives us: @NotNull, @NotBlank, @Size, and method argument validation. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             Test Scope Dependencies
             scope=test means these JARs are NEVER included in the
             production artifact — they only exist during test runs.
             ============================================================ -->

        <!-- JUnit 5 + Mockito + Spring Test support + AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ============================================================
         Build Plugins
         The spring-boot-maven-plugin repackages the compiled JAR
         into a "fat JAR" (uber JAR) that contains all dependencies,
         making it self-contained and runnable with:
           java -jar notification-platform.jar
         ============================================================ -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
